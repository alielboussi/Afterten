rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/app_users/$(request.auth.uid)).data;
    }

    function isActiveOutletUser() {
      return signedIn()
        && userDoc().active == true
        && userDoc().outletId is string;
    }

    match /signatures/{outletId}/{allPaths=**} {
      allow read: if isActiveOutletUser() && outletId == userDoc().outletId;
      allow write: if isActiveOutletUser()
        && outletId == userDoc().outletId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /orders/{outletId}/{allPaths=**} {
      allow read: if isActiveOutletUser() && outletId == userDoc().outletId;
      allow write: if isActiveOutletUser()
        && outletId == userDoc().outletId
        && request.resource.size < 15 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
