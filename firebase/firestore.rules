rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data;
    }

    function isActiveOutletUser() {
      return signedIn()
        && userDoc().active == true
        && userDoc().outletId is string
        && userDoc().outletId.size() > 0;
    }

    function outletId() {
      return userDoc().outletId;
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /app_users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /outlets/{id} {
      allow read: if isActiveOutletUser() && id == outletId();
      allow write: if false;
    }

    match /catalog_lines/{lineId} {
      allow read: if isActiveOutletUser() && resource.data.outletId == outletId();
      allow write: if false;
    }

    match /outlet_orders/{orderId} {
      allow read: if isActiveOutletUser() && resource.data.outletId == outletId();
      allow write: if false;

      match /items/{itemId} {
        allow read: if isActiveOutletUser()
          && get(/databases/$(database)/documents/outlet_orders/$(orderId)).data.outletId == outletId();
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
