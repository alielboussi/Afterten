# Copy to secrets/supabase.env (gitignored) and fill from Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Transaction pooler (port 6543) — recommended for scripts / npm run supabase:query
# Dashboard → Database → Connection string → URI → Transaction pooler
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
