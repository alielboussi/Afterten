{
  "expo": {
    "name": "Afterten Supervisor",
    "slug": "afterten-supervisor",
    "scheme": "afterten-supervisor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.afterten.supervisor"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e3a8a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "55f3988b-3adc-4756-be26-360241c525d7"
      }
    },
    "owner": "afterten-and-bestrest"
  }
}
