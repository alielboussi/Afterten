# Portal (Next.js on Vercel) — copy to afterten-orders/.env.local (gitignored)
# Same values as secrets/supabase.env (anon + URL only)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — portal admin user list / Make admin (never NEXT_PUBLIC_, never Expo)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Order webhook (Supabase order_notify_config must match ORDER_NOTIFY_WEBHOOK_SECRET)
ORDER_NOTIFY_WEBHOOK_SECRET=generate_a_long_random_string

# WasenderAPI — outlet order alerts to WhatsApp group (JID ends with @g.us)
WASENDER_API_KEY=your_wasender_api_key
WHATSAPP_ORDERS_GROUP_JID=120363322213463398@g.us
