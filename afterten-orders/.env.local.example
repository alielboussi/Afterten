# Portal (Next.js on Vercel) — copy to afterten-orders/.env.local (gitignored)
# Same values as secrets/supabase.env (anon + URL only)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server only — portal admin user list / Make admin (never NEXT_PUBLIC_, never Expo)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
